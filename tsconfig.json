{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": false,
		"checkJs": false,
		"strict": true,
		"removeComments": true,
		"declaration": true,
		"noImplicitAny": true,
		"noEmitHelpers": true,
		"sourceMap": true,
		"rootDir": "./src",
		"baseUrl": ".",
		"ignoreDeprecations": "5.0",
		"experimentalDecorators": true,
		"esModuleInterop": true,
	},
	"include": ["./src/**/*.ts"],
	"exclude": ["node_modules", ".rpt2_cache"],
}
