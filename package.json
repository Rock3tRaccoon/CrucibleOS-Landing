{
	"name": "crucible-frontend",
	"version": "0.0.1",
	"type": "module",
	"description": "CrucibleOS marketing + documentation site",
	"main": "",
	"dependencies": {
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-multi-entry": "^7.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^0.4.4",
		"autoprefixer": "^10.4.27",
		"dom-native": "^0.11.5",
		"pcss-cli": "^0.3.0",
		"postcss": "^8.5.8",
		"postcss-import": "^16.1.1",
		"postcss-nested": "^7.0.2",
		"resend": "^6.12.4",
		"rollup": "^4.60.1",
		"rollup-plugin-typescript2": "^0.37.0",
		"sec-ui": "file:./vendor/sec-ui",
		"servor": "^4.0.2",
		"typescript": "^5.6.3",
		"utils-min": "^0.2.4"
	},
	"scripts": {
		"prepack": "npm run build",
		"copy-assets": "node scripts/copy-assets.js",
		"vendor-sec-ui": "node scripts/vendor-sec-ui.js",
		"localhost": "servor web-folder index.html 8083 --reload",
		"build-js": "./node_modules/.bin/rollup -c rollup.config.js",
		"build-css": "./node_modules/.bin/pcss -c pcss.config.js",
		"build": "npm run copy-assets && npm run build-js && npm run build-css",
		"ui-dev": "npm run copy-assets && rollup -c -w & pcss -w & npm run localhost"
	},
	"devDependencies": {
		"@types/node": "^25.5.2",
		"terser": "^5.36.0"
	}
}
